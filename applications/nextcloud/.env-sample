# Nextcloud Env
MYSQL_HOST=mysql-host
MYSQL_DATABASE=nextcloud
MYSQL_USER_FILE=/run/secrets/mysqluser-sample
MYSQL_PASSWORD_FILE=/run/secrets/mysqlpass-sample

NEXTCLOUD_ADMIN_USER_FILE=/run/secrets/nextcloud_adm_user-sample
NEXTCLOUD_ADMIN_PASSWORD_FILE=/run/secrets/nextcloud_adm_pass-sample

REDIS_HOST=nextcloud-redis
REDIS_HOST_PASSWORD=redispass

PHP_MEMORY_LIMIT=1G
PHP_UPLOAD_LIMIT=1G
