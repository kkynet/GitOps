# db-pterodactyl env
MYSQL_PASSWORD=password
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=panel
MYSQL_USER=user

# panel-pterodactyl env
APP_URL=http://domain.com:8081
APP_TIMEZONE=Asia/Makassar
APP_SERVICE_AUTHOR=user@domain.com

MAIL_FROM=user@domain.com
MAIL_DRIVER=smtp
MAIL_HOST=mx0.domain.com
MAIL_PORT=587
MAIL_USERNAME=user@domain.com
MAIL_PASSWORD=password
MAIL_ENCRYPTION=tls

APP_ENV=production
APP_ENVIRONMENT_ONLY=false
APP_KEY=secretapikey

CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_DRIVER=redis
REDIS_HOST=redis-pterodactyl

DB_HOST=db-pterodactyl
DB_PORT=3306
DB_PASSWORD=password

